<?php
// ==================== ЗАДАЧА 1 ====================
$result1 = "";

if (isset($_POST['task1'])) {
    $digit = $_POST['digit'] ?? "";

    if (preg_match('/^[0-9]$/', $digit)) {
        $result1 = match ((int)$digit) {
            0 => "zero",
            1 => "one",
            2 => "two",
            3 => "three",
            4 => "four",
            5 => "five",
            6 => "six",
            7 => "seven",
            8 => "eight",
            9 => "nine",
        };
    } else {
        $result1 = "Введите цифру от 0 до 9";
    }
}


// ==================== ЗАДАЧА 2 ====================
$result2 = "";

if (isset($_POST['task2'])) {
    $month = (int)($_POST['month'] ?? 0);

    $result2 = match ($month) {
        1 => "1 января — Новый год\n" .
             "7 января — Рождество Христово",

        2 => "23 февраля — День защитника Отечества",

        3 => "8 марта — Международный женский день",

        4 => "1 апреля — День смеха",

        5 => "1 мая — Праздник Весны и Труда\n" .
             "9 мая — День Победы",

        6 => "12 июня — День России",

        7 => "8 июля — День семьи, любви и верности",

        8 => "22 августа — День Государственного флага России",

        9 => "1 сентября — День знаний",

        10 => "5 октября — День учителя",

        11 => "4 ноября — День народного единства",

        12 => "12 декабря — День Конституции России",

        default => "Введите номер месяца от 1 до 12"
    };
}


// ==================== ЗАДАЧА 3 ====================
$result3 = "";

if (isset($_POST['task3'])) {
    $number = trim($_POST['number'] ?? "");

    if (preg_match('/^-?\d+$/', $number)) {
        $lastDigit = (int)substr($number, -1);

        $result3 = match ($lastDigit) {
            0 => 0,
            1 => 1,
            2 => 4,
            3 => 9,
            4 => 6,
            5 => 5,
            6 => 6,
            7 => 9,
            8 => 4,
            9 => 1,
        };
    } else {
        $result3 = "Введите целое число";
    }
}


// ==================== ЗАДАЧА 4 ====================
$result4 = "";

if (isset($_POST['task4'])) {
    $inputK = $_POST['k'] ?? "";

    if (preg_match('/^\d+$/', $inputK)
        && (int)$inputK >= 1
        && (int)$inputK <= 99) {

        $k = (int)$inputK;
        $lastTwo = $k % 100;
        $lastOne = $k % 10;

        $word = match (true) {
            $lastTwo >= 11 && $lastTwo <= 14 => "лет",
            $lastOne === 1 => "год",
            $lastOne >= 2 && $lastOne <= 4 => "года",
            default => "лет"
        };

        $result4 = "Мне $k $word";
    } else {
        $result4 = "Введите целое число от 1 до 99";
    }
}


// ==================== ЗАДАЧА 5 ====================
$result5 = "";

if (isset($_POST['task5'])) {
    $massInput = trim($_POST['mass'] ?? "");
    $units = $_POST['units'] ?? [];

    if (!is_array($units)) {
        $units = [];
    }

    if ($massInput === "" || !is_numeric($massInput)
        || (float)$massInput < 0) {
        $result5 = "Введите корректную массу (неотрицательное число)";
    } elseif (empty($units)) {
        $result5 = "Выберите хотя бы одну единицу измерения";
    } else {
        foreach ($units as $unit) {
            $unit = (string)$unit;

            $coefficient = match ($unit) {
                "kg" => 1,
                "mg" => 0.000001,
                "g"  => 0.001,
                "t"  => 1000,
                "c"  => 100,
                default => null
            };

            $unitName = match ($unit) {
                "kg" => "килограмм",
                "mg" => "миллиграмм",
                "g"  => "грамм",
                "t"  => "тонна",
                "c"  => "центнер",
                default => null
            };

            if ($coefficient !== null) {
                $kg = (float)$massInput * $coefficient;

                $formatted = rtrim(
                    rtrim(number_format($kg, 6, '.', ''), '0'),
                    '.'
                );

                $result5 .= htmlspecialchars($massInput)
                    . " " . $unitName . " = "
                    . $formatted . " кг\n";
            }
        }

        if ($result5 === "") {
            $result5 = "Выберите корректную единицу измерения";
        }
    }
}
