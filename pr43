<h2>Задание 3</h2>
<?php
$arr = [];
for ($i = 0; $i < 5; $i++) {
    for ($j = 0; $j < 4; $j++) {
        $arr[$i][$j] = rand(1, 100);
    }
}

$max = $arr[0][0]; $maxI = 0; $maxJ = 0;
$min = $arr[0][0]; $minI = 0; $minJ = 0;

foreach ($arr as $i => $row) {
    foreach ($row as $j => $val) {
        if ($val > $max) { $max = $val; $maxI = $i; $maxJ = $j; }
        if ($val < $min) { $min = $val; $minI = $i; $minJ = $j; }
    }
}

echo "Массив:<br>";
echo "<table border='1' cellpadding='5'>";
foreach ($arr as $row) {
    echo "<tr>";
    foreach ($row as $val) echo "<td>$val</td>";
    echo "</tr>";
}
echo "</table>";

echo "Максимум: $max (строка $maxI, столбец $maxJ)<br>";
echo "Минимум: $min (строка $minI, столбец $minJ)<br>";
?>
