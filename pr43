<h2>Задание 8</h2>
<?php
function addCategoryOrProducts(array &$shop, string $category, array $products): void {
    if (!isset($shop[$category])) {
        $shop[$category] = [];
    }
    foreach ($products as $brand => $product) {
        $shop[$category][$brand] = $product;
    }
}

addCategoryOrProducts($shop, "Футбол", [
    "Reebok" => "Скакалка",
    "Nike"   => "Эспандер"
]);

addCategoryOrProducts($shop, "Большой теннис", [
    "Wilson"  => "Ракетка теннисная",
    "Babolat" => "Мяч теннисный"
]);

foreach ($shop as $category => $products) {
    echo "<h3>$category</h3>";
    if (empty($products)) {
        echo "Здесь пока нет товаров<br>";
    } else {
        echo "<ul>";
        foreach ($products as $brand => $product) {
            echo "<li>$product (фирма: $brand)</li>";
        }
        echo "</ul>";
    }
}
